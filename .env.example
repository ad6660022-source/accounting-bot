# ==============================
# Telegram Bot
# ==============================
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ==============================
# PostgreSQL
# ==============================
POSTGRES_PASSWORD=secret

# Docker (хост = "db"), локально (хост = "localhost")
DATABASE_URL=postgresql+asyncpg://postgres:secret@db:5432/accounting_bot

# ==============================
# Mini App
# ==============================
# После деплоя на Railway — вставь HTTPS-ссылку
WEBAPP_URL=https://your-app.up.railway.app
PORT=8000

# ==============================
# Безопасность
# ==============================
# Код для получения прав администратора: отправь боту /start КОД
# Смени после первого использования!
ADMIN_INVITE_CODE=ACC-ADMIN-2025

# Telegram ID известных администраторов (через запятую, опционально)
ADMIN_IDS=

# ==============================
# Подписки (Telegram Stars)
# ==============================
# Pro тариф: до 5 ИП, 10 участников
PRO_PRICE_STARS=199

# Business тариф: без ограничений
BUSINESS_PRICE_STARS=499
